{
  "collections": {
    "users": {
      "description": "Collection of basketball coaches and their data",
      "documents": {
        "{uid}": {
          "schema": {
            "profiel": {
              "type": "map",
              "description": "User profile details like email and last active timestamp"
            },
            "membership": {
              "type": "map",
              "description": "Membership status, type, trial, and approval details"
            },
            "role": {
              "type": "string",
              "description": "System role of the user ('admin' or 'user')"
            },
            "spelers": {
              "type": "array",
              "description": "List of tracked basketball players and their stats"
            },
            "wedstrijden": {
              "type": "array",
              "description": "Historical matches recorded by the coach"
            },
            "instellingen": {
              "type": "map",
              "description": "Active game settings, timers, matches, and app preferences"
            }
          }
        }
      }
    },
    "teams": {
      "description": "Collection of basketball teams created by coaches",
      "documents": {
        "{teamId}": {
          "schema": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "userId": { "type": "string" },
            "clubId": { "type": "string" },
            "createdAt": { "type": "number" }
          }
        }
      }
    },
    "players": {
      "description": "Collection of global basketball players",
      "documents": {
        "{playerId}": {
          "schema": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "number": { "type": "string" },
            "position": { "type": "string" },
            "userId": { "type": "string" },
            "createdAt": { "type": "number" },
            "totalTime": { "type": "number" },
            "isRunning": { "type": "boolean" },
            "stats": { "type": "map" }
          }
        }
      }
    },
    "teamPlayers": {
      "description": "Collection of mappings between teams and players",
      "documents": {
        "{mappingId}": {
          "schema": {
            "teamId": { "type": "string" },
            "playerId": { "type": "string" },
            "createdAt": { "type": "number" },
            "role": { "type": "string" }
          }
        }
      }
    },
    "audit_logs": {
      "description": "Collection of system audit logs for administrative actions",
      "documents": {
        "{logId}": {
          "schema": {
            "timestamp": { "type": "number" },
            "adminUid": { "type": "string" },
            "targetUid": { "type": "string" },
            "action": { "type": "string" },
            "oldValue": { "type": "map" },
            "newValue": { "type": "map" }
          }
        }
      }
    },
    "clubs": {
      "description": "Collection of club workspaces for club memberships",
      "documents": {
        "{clubId}": {
          "schema": {
            "naam": { "type": "string" },
            "ownerUid": { "type": "string" },
            "createdAt": { "type": "number" },
            "subscriptionType": { "type": "string" }
          }
        }
      }
    },
    "club_members": {
      "description": "Collection of members belonging to club workspaces",
      "documents": {
        "{docId}": {
          "schema": {
            "clubId": { "type": "string" },
            "userUid": { "type": "string" },
            "role": { "type": "string" },
            "status": { "type": "string" },
            "joinedAt": { "type": "number" }
          }
        }
      }
    },
    "club_invites": {
      "description": "Collection of club invitation records",
      "documents": {
        "{inviteId}": {
          "schema": {
            "clubId": { "type": "string" },
            "email": { "type": "string" },
            "displayName": { "type": "string" },
            "role": { "type": "string" },
            "status": { "type": "string" },
            "createdAt": { "type": "number" },
            "createdBy": { "type": "string" },
            "expiresAt": { "type": "number" }
          }
        }
      }
    }
  }
}
