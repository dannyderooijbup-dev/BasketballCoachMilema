rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIES VOOR BEVEILIGINGSCONTROLES
    // ==========================================

    // Controleert of de gebruiker succesvol is ingelogd via Firebase Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Controleert of de ingelogde gebruiker de eigenaar is op basis van de opgegeven userId
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Haalt de data op van een specifiek team uit de database
    function getTeam(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    // Haalt de data op van een specifieke speler uit de database
    function getPlayer(playerId) {
      return get(/databases/$(database)/documents/players/$(playerId)).data;
    }

    // Controleert of de ingelogde gebruiker de eigenaar is van het gekoppelde team of dat het team gedeeld is via de club workspace
    function isTeamOwner(teamId) {
      return isSignedIn() && (
        getTeam(teamId).userId == request.auth.uid ||
        ('clubId' in getTeam(teamId) && getTeam(teamId).clubId != null && isClubMember(getTeam(teamId).clubId))
      );
    }

    // Controleert of een gebruiker lid is van een club workspace
    function isClubMember(clubId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/clubs/$(clubId)) && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid) ||
        exists(/databases/$(database)/documents/club_members/$(clubId + '_' + request.auth.uid))
      );
    }

    // Controleert of een gebruiker beheerder of coach is binnen een club workspace (beheerrechten voor club teams)
    function canManageClubTeams(clubId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/clubs/$(clubId)) && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/club_members/$(clubId + '_' + request.auth.uid)) && 
          (get(/databases/$(database)/documents/club_members/$(clubId + '_' + request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/club_members/$(clubId + '_' + request.auth.uid)).data.role == 'coach'))
      );
    }

    // Controleert of de ingelogde gebruiker de eigenaar is van de gekoppelde speler
    function isPlayerOwner(playerId) {
      return isSignedIn() && getPlayer(playerId).userId == request.auth.uid;
    }

    // Controleert of de ingelogde gebruiker beheerder is (role == 'admin')
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Standaard deny-all regel om ongeautoriseerde toegang tot onbekende collecties te voorkomen
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // USERS COLLECTIE
    // ==========================================
    match /users/{userId} {
      // Eigenaar mag eigen gegevens beheren; admins mogen alle gebruikersprofielen lezen en bewerken
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // AUDIT LOGS COLLECTIE
    // ==========================================
    match /audit_logs/{logId} {
      // Beheerders en ingelogde clubbeheerders mogen audit logs inzien en toevoegen
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // ==========================================
    // TEAMS COLLECTIE
    // ==========================================
    match /teams/{teamId} {
      // Alleen ingelogde coaches/clubleden mogen teams aanmaken
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && (
          !('clubId' in request.resource.data) 
          || request.resource.data.clubId == null 
          || request.resource.data.clubId == '' 
          || canManageClubTeams(request.resource.data.clubId)
        )
        // Validatie van verplichte velden, datatypes en bekende velden
        && request.resource.data.keys().hasAll(['id', 'name', 'userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'name', 'userId', 'createdAt', 'colorScheme', 'clubId'])
        && request.resource.data.id is string
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 100 // Maximale lengte voor teamnaam
        && request.resource.data.userId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && (!('colorScheme' in request.resource.data) || request.resource.data.colorScheme is string)
        && (!('clubId' in request.resource.data) || request.resource.data.clubId == null || request.resource.data.clubId is string);

      // Eigenaars, admins en actieve clubleden mogen het team lezen
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        ('clubId' in resource.data && resource.data.clubId != null && isClubMember(resource.data.clubId))
      );

      // Eigenaars, admins en clubbeheerders/coaches mogen het team verwijderen
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        ('clubId' in resource.data && resource.data.clubId != null && canManageClubTeams(resource.data.clubId))
      );

      // Eigenaars, admins en clubbeheerders/coaches mogen het team wijzigen; onveranderbare velden blijven beschermd
      allow update: if isSignedIn() 
        && (
          resource.data.userId == request.auth.uid ||
          isAdmin() ||
          ('clubId' in resource.data && resource.data.clubId != null && canManageClubTeams(resource.data.clubId))
        )
        && request.resource.data.userId == resource.data.userId // userId mag niet gewijzigd worden
        && resource.data.id == request.resource.data.id // document-ID (id) mag nooit gewijzigd worden
        && resource.data.createdAt == request.resource.data.createdAt // aanmaaktijdstip (createdAt) mag nooit gewijzigd worden
        // Validatie van de nieuwe document data
        && request.resource.data.keys().hasAll(['id', 'name', 'userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'name', 'userId', 'createdAt', 'colorScheme', 'clubId'])
        && request.resource.data.id is string
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 100
        && request.resource.data.userId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && (!('colorScheme' in request.resource.data) || request.resource.data.colorScheme is string)
        && (!('clubId' in request.resource.data) || request.resource.data.clubId == null || request.resource.data.clubId is string);
    }

    // ==========================================
    // PLAYERS COLLECTIE
    // ==========================================
    match /players/{playerId} {
      // Alleen ingelogde coaches mogen spelers aanmaken en zij moeten zichzelf als eigenaar registreren
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        // Validatie van alle verplichte velden en hun datatypes
        && request.resource.data.keys().hasAll(['id', 'name', 'number', 'position', 'totalTime', 'isRunning', 'sessions', 'stats', 'lastActions', 'userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'name', 'number', 'position', 'totalTime', 'isRunning', 'lastStartTime', 'sessions', 'stats', 'lastActions', 'userId', 'createdAt'])
        && request.resource.data.id is string
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 100 // Maximale lengte voor spelersnaam
        && request.resource.data.number is string 
        && request.resource.data.number.size() <= 10 // Maximaal 10 tekens voor rugnummer
        && request.resource.data.position is string 
        && request.resource.data.position.size() <= 50
        && (request.resource.data.totalTime is int || request.resource.data.totalTime is float)
        && request.resource.data.isRunning is bool
        && request.resource.data.sessions is list
        && request.resource.data.stats is map
        && request.resource.data.lastActions is list
        && request.resource.data.userId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && (!('lastStartTime' in request.resource.data) || request.resource.data.lastStartTime == null || request.resource.data.lastStartTime is int || request.resource.data.lastStartTime is float);

      // Alleen de eigenaar mag de speler lezen of verwijderen
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Alleen de eigenaar mag de speler wijzigen; diverse systeemvelden zijn onveranderbaar (immutable)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid // userId mag niet gewijzigd worden
        && resource.data.userId == request.resource.data.userId // eigenaar (userId) van document mag nooit gewijzigd worden
        && resource.data.id == request.resource.data.id // document-ID (id) mag nooit gewijzigd worden
        && resource.data.createdAt == request.resource.data.createdAt // aanmaaktijdstip (createdAt) mag nooit gewijzigd worden
        // Validatie van alle gewijzigde velden en hun datatypes
        && request.resource.data.keys().hasAll(['id', 'name', 'number', 'position', 'totalTime', 'isRunning', 'sessions', 'stats', 'lastActions', 'userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'name', 'number', 'position', 'totalTime', 'isRunning', 'lastStartTime', 'sessions', 'stats', 'lastActions', 'userId', 'createdAt'])
        && request.resource.data.id is string
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 100
        && request.resource.data.number is string 
        && request.resource.data.number.size() <= 10
        && request.resource.data.position is string 
        && request.resource.data.position.size() <= 50
        && (request.resource.data.totalTime is int || request.resource.data.totalTime is float)
        && request.resource.data.isRunning is bool
        && request.resource.data.sessions is list
        && request.resource.data.stats is map
        && request.resource.data.lastActions is list
        && request.resource.data.userId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && (!('lastStartTime' in request.resource.data) || request.resource.data.lastStartTime == null || request.resource.data.lastStartTime is int || request.resource.data.lastStartTime is float);
    }

    // ==========================================
    // TEAMPLAYERS (MAPPING) COLLECTIE
    // ==========================================
    match /teamPlayers/{docId} {
      // Helper om te bepalen of de ingelogde gebruiker de eigenaar is van deze koppeling
      // Fallback is ingebouwd om teams/spelers te checken als userId nog niet op de documenten aanwezig is (achterwaartse compatibiliteit)
      function isMappingOwner() {
        return (resource.data.userId == request.auth.uid) || 
               isTeamOwner(resource.data.teamId) || 
               isPlayerOwner(resource.data.playerId);
      }

      // Alleen ingelogde gebruikers die eigenaar zijn van het gekoppelde team en de speler mogen koppelingen aanmaken
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isTeamOwner(request.resource.data.teamId)
        && isPlayerOwner(request.resource.data.playerId)
        // Validatie van de mapping velden en datatypes
        && request.resource.data.keys().hasAll(['id', 'teamId', 'playerId', 'createdAt', 'userId'])
        && request.resource.data.keys().hasOnly(['id', 'teamId', 'playerId', 'createdAt', 'userId', 'role'])
        && request.resource.data.id is string
        && request.resource.data.teamId is string
        && request.resource.data.playerId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && request.resource.data.userId is string
        && (!('role' in request.resource.data) || request.resource.data.role is string && request.resource.data.role.size() <= 50);

      // Alleen de eigenaar mag de koppeling lezen of verwijderen
      allow read, delete: if isSignedIn() && isMappingOwner();

      // Alleen de eigenaar mag de koppeling aanpassen; diverse velden zijn onveranderbaar en de relaties worden opnieuw gecontroleerd
      allow update: if isSignedIn()
        && isMappingOwner()
        && request.resource.data.userId == request.auth.uid // userId mag niet gewijzigd worden
        && resource.data.userId == request.resource.data.userId // eigenaar (userId) van document mag nooit gewijzigd worden
        && resource.data.id == request.resource.data.id // document-ID (id) mag nooit gewijzigd worden
        && resource.data.createdAt == request.resource.data.createdAt // aanmaaktijdstip (createdAt) mag nooit gewijzigd worden
        && isTeamOwner(request.resource.data.teamId) // Opnieuw verifiëren dat het nieuwe/bestaande teamId toebehoort aan de ingelogde coach
        && isPlayerOwner(request.resource.data.playerId) // Opnieuw verifiëren dat het nieuwe/bestaande playerId toebehoort aan de ingelogde coach
        // Validatie van de nieuwe document data
        && request.resource.data.keys().hasAll(['id', 'teamId', 'playerId', 'createdAt', 'userId'])
        && request.resource.data.keys().hasOnly(['id', 'teamId', 'playerId', 'createdAt', 'userId', 'role'])
        && request.resource.data.id is string
        && request.resource.data.teamId is string
        && request.resource.data.playerId is string
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && request.resource.data.userId is string
        && (!('role' in request.resource.data) || request.resource.data.role is string && request.resource.data.role.size() <= 50);
    }

    // ==========================================
    // CLUBS COLLECTIE
    // ==========================================
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ==========================================
    // CLUB MEMBERS COLLECTIE
    // ==========================================
    match /club_members/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // ==========================================
    // CLUB INVITES COLLECTIE
    // ==========================================
    match /club_invites/{inviteId} {
      // Clubleden, admins en de genodigde (op e-mailadres) mogen de uitnodiging lezen
      allow read: if isSignedIn();
      
      // Clubbeheerders/coaches en admins mogen uitnodigingen aanmaken
      allow create: if isSignedIn() 
        && request.resource.data.createdBy == request.auth.uid
        && (canManageClubTeams(request.resource.data.clubId) || isAdmin())
        && request.resource.data.keys().hasAll(['clubId', 'email', 'displayName', 'role', 'status', 'createdAt', 'createdBy', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['clubId', 'email', 'displayName', 'role', 'status', 'createdAt', 'createdBy', 'expiresAt'])
        && request.resource.data.clubId is string
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['coach', 'assistant']
        && request.resource.data.status in ['pending', 'accepted', 'cancelled']
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is float)
        && request.resource.data.createdBy is string
        && (request.resource.data.expiresAt is int || request.resource.data.expiresAt is float);

      // Clubbeheerders, admins of de genodigde mogen uitnodigingen bijwerken (bijv. annuleren of accepteren)
      allow update: if isSignedIn() 
        && (canManageClubTeams(resource.data.clubId) || isAdmin() || resource.data.email == request.auth.token.email)
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Clubbeheerders en admins mogen uitnodigingen verwijderen
      allow delete: if isSignedIn() && (canManageClubTeams(resource.data.clubId) || isAdmin());
    }

    // ==========================================
    // MAIL QUEUE & EMAIL LOGS COLLECTIES
    // ==========================================
    match /mail_queue/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /email_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}
